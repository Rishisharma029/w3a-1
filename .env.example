# SECURITY NOTE:
# Do not commit real credentials. If any previously committed cloud tokens,
# webhook secrets, or non-local private keys were reused, rotate/revoke them.
#
# ---- Local Stack & Network Configuration ----
NETWORK=localhost
CHAIN_ID=31337
CAIP2_NETWORK=eip155:31337
HARDHAT_PORT=8545
MARKETPLACE_PORT=14210
DASHBOARD_PORT=14300

# ---- Smart Contract Addresses (Localhost / Hardhat) ----
ENFORCER_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
TOKEN_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# ---- Signers & Cryptographic Keypairs ----
# Local Hardhat default addresses are provided for convenience.
# Set private keys from your local secret store or a private .env only.
OWNER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
OWNER_PRIVATE_KEY=

AGENT_ADDRESS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8
AGENT_PRIVATE_KEY=

PROVIDER_ALPHA_ADDRESS=0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC
