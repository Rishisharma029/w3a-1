# ---- Accounting & Financial Invariants ----
UNIT_MULTIPLIER=1
TOKEN_DECIMALS=6
INITIAL_ESCROW_FUNDING=50.00
AUTHORIZED_BUDGET=20.00
DEFAULT_SPEND_CAP=5.00

# ---- Cloud Orchestrator (n8n Cloud & MCP Gateway) ----
N8N_WEBHOOK_URL=
N8N_MCP_URL=
N8N_ACCESS_KEY=

